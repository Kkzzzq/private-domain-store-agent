# 复制为 .env 后按本机修改。不要把 .env 提交到 GitHub。
DATABASE_URL=mysql+pymysql://store:store@127.0.0.1:3306/private_store?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PATH=./data/chroma
AGENT_MODE=auto
SESSION_MAX_CHARS=2400
AGENT_MAX_STEPS=4
AGENT_RATE_LIMIT_PER_MINUTE=30

# 全部聊天入口统一用千问；密钥文件放在仓库外，以下路径需按部署环境替换。
MODEL_PROVIDER=cloud
CLOUD_MODEL=qwen-flash
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_API_STYLE=qwen
CLOUD_API_KEY_FILE=/path/outside/repository/qwen-api-key
CLOUD_FALLBACK_MODELS=
QA_CHAT_MODEL=qwen-flash
QA_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QA_CHAT_API_STYLE=qwen
QA_CHAT_API_KEY_FILE=/path/outside/repository/qwen-api-key
QA_TARGET_CHAT_MODEL=qwen-flash
QA_TARGET_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QA_TARGET_CHAT_API_STYLE=qwen
QA_TARGET_CHAT_API_KEY_FILE=/path/outside/repository/qwen-api-key

# 向量检索使用专用模型，与聊天共用新账号凭据。
EMBEDDING_PROVIDER=qwen
CLOUD_EMBEDDING_MODEL=qwen3.7-text-embedding
CLOUD_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_EMBEDDING_API_KEY_FILE=/path/outside/repository/qwen-api-key
CLOUD_EMBEDDING_DIMENSIONS=1024
