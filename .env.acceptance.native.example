ACCEPTANCE_ENVIRONMENT=true
DATABASE_URL=mysql+pymysql://acceptance:acceptance-local-only@127.0.0.1:13306/private_store_acceptance?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/1
JWT_SECRET=acceptance-only-secret-at-least-32-characters
MODEL_PROVIDER=cloud
CLOUD_API_STYLE=zhipu
CLOUD_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CLOUD_MODEL=glm-5.3-flashx
CLOUD_FALLBACK_MODELS=
CLOUD_MAX_TOKENS=4096
CLOUD_TIMEOUT_SECONDS=90
CLOUD_API_KEY_FILE=D:/qiuzhao/API/zhipu_api.txt
EMBEDDING_PROVIDER=zhipu
CLOUD_EMBEDDING_MODEL=embedding-3
CLOUD_EMBEDDING_DIMENSIONS=1024
AGENT_MODE=auto
STRICT_DEPENDENCIES=true
AGENT_REQUIRE_LLM=true
RAG_REQUIRE_VECTORS=true
AGENT_RATE_LIMIT_PER_MINUTE=120
CHROMA_PATH=./data/acceptance/chroma-zhipu
CHROMA_COLLECTION=acceptance_zhipu_embedding3_d1024_v1
