ACCEPTANCE_ENVIRONMENT=true
DATABASE_URL=mysql+pymysql://acceptance:acceptance-local-only@127.0.0.1:13306/private_store_acceptance?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/1
JWT_SECRET=acceptance-only-secret-at-least-32-characters
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=quentinz/bge-small-zh-v1.5
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=512
MODEL_PROVIDER=ollama
AGENT_MODE=auto
STRICT_DEPENDENCIES=true
AGENT_REQUIRE_LLM=true
RAG_REQUIRE_VECTORS=true
AGENT_RATE_LIMIT_PER_MINUTE=120
CHROMA_PATH=./data/acceptance/chroma
CHROMA_COLLECTION=acceptance_knowledge_zh_v1
